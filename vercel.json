{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon\\.svg|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*\\.js|pwa-.*\\.png|apple-touch-icon\\.png|@vite/|@react-refresh|@id/|@fs/|src/|node_modules/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/drive-video.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
